# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED
# ─────────────────────────────────────────────────────────────────────────────
# Server-side Deepgram API key. Used by the Node proxy to open the Voice Agent
# WebSocket (wss://agent.deepgram.com/v1/agent/converse). It is never exposed to
# the browser. Get one at https://console.deepgram.com
DEEPGRAM_API_KEY="your_actual_deepgram_api_key"

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL / DEPLOYMENT
# ─────────────────────────────────────────────────────────────────────────────
# Port for the Express + WebSocket proxy (default: 3000). Render injects PORT —
# never hardcode it there.
# PORT=3000

# Bind address (default: 0.0.0.0). Containers and Render's router require
# 0.0.0.0, not 127.0.0.1.
# HOST=0.0.0.0

# "production" serves the built client from dist/ (what `npm start` does on
# Render). Any other value boots Vite dev middleware, which needs devDependencies.
# NODE_ENV="production"

# Override the upstream Voice Agent endpoint. Only useful for local testing
# against a mock server — leave unset for the real Deepgram API.
# DEEPGRAM_AGENT_URL="wss://agent.deepgram.com/v1/agent/converse"

# How long the proxy waits before relaying a KeepAlive upstream while the
# microphone uplink is silent (default: 8000 ms; the Voice Agent API closes
# sockets that go silent). Lowering this is only useful for tests.
# PROXY_IDLE_KEEPALIVE_MS=8000

# Set by Render automatically; surfaced as the short `commit` field of
# /api/health. Do not set by hand in production.
# RENDER_GIT_COMMIT=

# Legacy template variables (kept for compatibility with the AI Studio template;
# this app does not call the Gemini API).
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
